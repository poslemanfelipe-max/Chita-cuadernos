---
import { tienda } from '../data/tienda';

const enInicio = Astro.url.pathname === '/';
const ir = (ancla: string) => (enInicio ? ancla : `/${ancla}`);
const links = [
  { href: ir('#cuadernos'), texto: 'Cuadernos' },
  { href: ir('#como-comprar'), texto: 'Cómo comprar' },
  { href: ir('#preguntas'), texto: 'Preguntas' },
];
const { whatsapp, instagram } = tienda.contacto;
---

<header class="header">
  <div class="contenedor header__fila">
    <button class="icono menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" data-menu>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>

    <nav class="nav-escritorio" aria-label="Principal">
      {links.map((l) => <a href={l.href}>{l.texto}</a>)}
    </nav>

    <a href="/" class="marca" aria-label="Chita Cuadernos — inicio">
CHITA
    </a>

    <div class="header__derecha">
      {
        instagram && (
          <a class="icono ocultar-movil" href={`https://www.instagram.com/${instagram}/`} target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"></circle>
            </svg>
          </a>
        )
      }
      <button class="icono btn-carrito" type="button" data-abrir-carrito aria-label="Abrir carrito">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8Z"></path>
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8"></path>
        </svg>
        <span class="btn-carrito__num" data-contador hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="menu-movil" id="menu-movil" aria-label="Menú" hidden>
    {links.map((l) => <a href={l.href} data-cerrar-menu>{l.texto}</a>)}
    {whatsapp && <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>}
    {instagram && <a href={`https://www.instagram.com/${instagram}/`} target="_blank" rel="noopener">Instagram</a>}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(239 231 214 / 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea);
  }
  .header__fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 76px;
  }
  .marca {
    grid-column: 2;
    font: 300 2.1rem/1 var(--serif);
    letter-spacing: 0.1em;
    color: var(--vino);
    text-decoration: none;
    padding-left: 0.1em; /* compensa el espaciado de la última letra */
  }
  .marca:hover {
    color: var(--vino);
  }
  .nav-escritorio {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    gap: 28px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nav-escritorio a {
    text-decoration: none;
  }
  .header__derecha {
    grid-column: 3;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
  }
  .icono {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--vino);
    cursor: pointer;
  }
  .icono:hover {
    background: var(--papel-2);
    color: var(--vino);
  }
  .menu-btn {
    display: none;
    grid-column: 1;
    grid-row: 1;
    margin-left: -10px;
  }
  .btn-carrito__num {
    position: absolute;
    top: 3px;
    right: 1px;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--terracota);
    color: #fff;
    font: 600 0.7rem/19px var(--sans);
    text-align: center;
  }
  .menu-movil {
    display: grid;
    padding: 8px var(--gutter) 20px;
    border-top: 1px solid var(--linea);
  }
  .menu-movil[hidden] {
    display: none;
  }
  .menu-movil a {
    padding: 14px 0;
    border-bottom: 1px solid var(--linea);
    text-decoration: none;
    font: 300 1.4rem/1.2 var(--serif);
    color: var(--vino);
  }
  @media (max-width: 760px) {
    .nav-escritorio,
    .ocultar-movil {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
    .header__fila {
      height: 68px;
    }
    .marca {
      font-size: 1.8rem;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  const menu = document.getElementById('menu-movil')!;
  const cambiar = (abrir: boolean) => {
    menu.hidden = !abrir;
    btn.setAttribute('aria-expanded', String(abrir));
  };
  btn.addEventListener('click', () => cambiar(menu.hidden !== false));
  menu.addEventListener('click', (e) => (e.target as HTMLElement).closest('[data-cerrar-menu]') && cambiar(false));
</script>
