---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { formatoPrecio, productos, tienda } from '../data/tienda';
import { foto, fotosDeProducto } from '../lib/fotos';

const portada = foto('sitio/portada.jpg');
const enMano = foto('productos/nomade/02-suela-en-mano.jpg');
const desde = (p: (typeof productos)[number]) => Math.min(...p.variantes.map((v) => v.precio));
const { envio, retiro } = tienda.entrega;
---

<Base>
  <section class="hero">
    <div class="contenedor hero__grilla">
      <div class="hero__texto">
        <span class="antetitulo">Hecho a mano · Don Torcuato</span>
        <h1 set:html={tienda.portada.titulo.replace('\n', '<br />')} />
        <p>{tienda.portada.texto}</p>
        <a href="#cuadernos" class="boton">Ver cuadernos</a>
      </div>
      {
        portada && (
          <Image
            src={portada}
            alt="Pila de cuadernos Chita de cuero en distintos colores, a contraluz"
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 820px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            class="hero__foto"
          />
        )
      }
    </div>
  </section>

  <section class="seccion" id="cuadernos">
    <div class="contenedor">
      <div class="encabezado">
        <span class="antetitulo">La colección</span>
        <h2>Tres cuadernos, un mismo oficio</h2>
      </div>
      <ul class="productos">
        {
          productos.map((p) => {
            const f = fotosDeProducto(p.carpetaFotos)[0];
            return (
              <li>
                <a href={`/cuadernos/${p.id}`} class="tarjeta">
                  <div class="tarjeta__foto">
                    {f && <Image src={f} alt={p.nombre} widths={[400, 640, 800]} sizes="(max-width: 700px) 100vw, 33vw" />}
                  </div>
                  <h3>{p.nombre}</h3>
                  <p>{p.bajada}</p>
                  <span class="tarjeta__precio">
                    {p.variantes.length > 1 && 'Desde '}
                    {formatoPrecio(desde(p))}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="seccion oficio">
    <div class="contenedor oficio__grilla">
      {enMano && <Image src={enMano} alt="Chita Nómade de cuero suela en las manos" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 45vw" class="oficio__foto" />}
      <div>
        <span class="antetitulo">El oficio</span>
        <h2>Cuero, hilo y tiempo</h2>
        <p>
          Cada cuaderno se corta, se cose y se arma a mano, uno por uno. Por eso no hay dos iguales: las marcas del cuero y la costura cuentan cómo fue
          hecho.
        </p>
        <p>Si querés, lo grabamos con tu nombre, unas iniciales o la palabra que elijas.</p>
      </div>
    </div>
  </section>

  <section class="seccion" id="como-comprar">
    <div class="contenedor">
      <div class="encabezado">
        <span class="antetitulo">Cómo comprar</span>
        <h2>Simple, sin idas y vueltas</h2>
      </div>
      <ol class="pasos">
        <li>
          <span>1</span>
          <h3>Elegí</h3>
          <p>Sumá al carrito los cuadernos que quieras y, si querés, el texto del grabado.</p>
        </li>
        <li>
          <span>2</span>
          <h3>Pagá</h3>
          <p>Con Mercado Pago (tarjeta, débito o dinero en cuenta) o por transferencia bancaria.</p>
        </li>
        <li>
          <span>3</span>
          <h3>Recibí</h3>
          <p>{envio.texto} {envio.costo === null ? envio.textoSinCosto : ''} O retiralo en {retiro.texto.split('.')[0]}.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="seccion preguntas" id="preguntas">
    <div class="contenedor contenedor--angosto">
      <div class="encabezado">
        <span class="antetitulo">Preguntas frecuentes</span>
        <h2>Antes de comprar</h2>
      </div>
      {
        tienda.preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(24px, 5vw, 64px) clamp(48px, 8vw, 96px);
  }
  .hero__grilla {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .hero__texto p {
    font-size: 1.12rem;
    color: var(--tinta-suave);
    max-width: 38ch;
    margin: 20px 0 32px;
  }
  .hero__foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px 120px 6px 6px;
  }
  @media (max-width: 820px) {
    .hero__grilla {
      grid-template-columns: 1fr;
    }
    .hero__foto {
      order: -1;
      aspect-ratio: 4 / 3.6;
      border-radius: 6px 72px 6px 6px;
    }
  }

  .encabezado {
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .productos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 36px);
  }
  @media (max-width: 900px) {
    .productos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .productos {
      grid-template-columns: 1fr;
    }
  }
  .tarjeta {
    display: block;
    text-decoration: none;
  }
  .tarjeta__foto {
    overflow: hidden;
    border-radius: 6px;
    background: var(--papel-2);
    margin-bottom: 18px;
  }
  .tarjeta__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tarjeta:hover .tarjeta__foto :global(img) {
    transform: scale(1.04);
  }
  .tarjeta h3 {
    margin-bottom: 6px;
  }
  .tarjeta p {
    color: var(--tinta-suave);
    font-size: 0.95rem;
    margin-bottom: 10px;
  }
  .tarjeta__precio {
    font-weight: 500;
  }
  .tarjeta:hover h3 {
    color: var(--cuero);
  }

  .oficio {
    background: var(--papel-2);
  }
  .oficio__grilla {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .oficio__grilla h2 {
    margin-bottom: 20px;
  }
  .oficio__grilla p {
    color: var(--tinta-suave);
    font-size: 1.05rem;
    max-width: 44ch;
  }
  .oficio__foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 6px;
  }
  @media (max-width: 820px) {
    .oficio__grilla {
      grid-template-columns: 1fr;
    }
    .oficio__foto {
      aspect-ratio: 1;
    }
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pasos li {
    padding: 28px;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--blanco);
  }
  .pasos span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--cuero);
    color: #fff;
    font: 500 0.95rem/1 var(--sans);
    margin-bottom: 18px;
  }
  .pasos h3 {
    margin-bottom: 8px;
  }
  .pasos p {
    color: var(--tinta-suave);
    margin: 0;
  }
  @media (max-width: 820px) {
    .pasos {
      grid-template-columns: 1fr;
    }
  }

  .preguntas {
    padding-top: 0;
  }
  .contenedor--angosto {
    max-width: 780px;
  }
  details {
    border-bottom: 1px solid var(--linea);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font: 400 1.2rem/1.3 var(--serif);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--sans);
    color: var(--cuero);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    color: var(--tinta-suave);
    padding-bottom: 12px;
  }
</style>
