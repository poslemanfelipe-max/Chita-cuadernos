---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo-chita.png';
import { formatoPrecio, productos, tienda } from '../data/tienda';
import { foto, fotosDeProducto } from '../lib/fotos';

const portada = foto('sitio/portada.jpg');
const enMano = foto('productos/nomade/02-suela-en-mano.jpg');
const desde = (p: (typeof productos)[number]) => Math.min(...p.variantes.map((v) => v.precio));
const { envio, retiro } = tienda.entrega;
---

<Base>
  <section class="hero">
    <div class="contenedor hero__centro">
      <span class="antetitulo">Hecho a mano — Don Torcuato</span>
      <Image src={logo} alt="Chita" height={560} densities={[1, 2]} loading="eager" class="hero__logo" />
      <p class="hero__lema cursiva">{tienda.portada.lema}</p>
      <div class="manchas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <a href="#cuadernos" class="boton">Ver cuadernos</a>
    </div>
  </section>

  {
    portada && (
      <div class="banda">
        <Image
          src={portada}
          alt="Pila de cuadernos Chita de cuero en distintos colores, a contraluz"
          widths={[640, 960, 1400, 1920]}
          sizes="100vw"
          class="banda__foto"
        />
      </div>
    )
  }

  <section class="seccion" id="cuadernos">
    <div class="contenedor">
      <div class="encabezado">
        <span class="antetitulo">La colección</span>
        <h2>Todos los cuadernos</h2>
      </div>
      <ul class="productos">
        {
          productos.map((p) => {
            const f = fotosDeProducto(p.carpetaFotos)[0];
            return (
              <li>
                <a href={`/cuadernos/${p.id}`} class="tarjeta">
                  <div class="tarjeta__foto">
                    {f && <Image src={f} alt={p.nombre} widths={[320, 480, 720]} sizes="(max-width: 760px) 50vw, 33vw" />}
                  </div>
                  <h3>{p.nombre}</h3>
                  <span class="tarjeta__precio">
                    {p.variantes.length > 1 && <span class="desde">Desde </span>}
                    {formatoPrecio(desde(p))}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="seccion oficio">
    <div class="contenedor oficio__grilla">
      {enMano && <Image src={enMano} alt="Chita Nómade de cuero suela en las manos" widths={[480, 800]} sizes="(max-width: 820px) 100vw, 45vw" class="oficio__foto" />}
      <div>
        <span class="antetitulo">El oficio</span>
        <h2>Cuero, hilo y tiempo</h2>
        <p>
          Cada cuaderno se corta, se cose y se arma a mano, uno por uno. Por eso no hay dos iguales: las marcas del cuero y la costura cuentan cómo fue
          hecho.
        </p>
        <p>Si querés, lo grabamos con tu nombre, unas iniciales o la palabra que elijas.</p>
        <p class="oficio__lema cursiva">“{tienda.portada.lema}”</p>
      </div>
    </div>
  </section>

  <section class="seccion" id="como-comprar">
    <div class="contenedor">
      <div class="encabezado">
        <span class="antetitulo">Cómo comprar</span>
        <h2>Simple, sin idas y vueltas</h2>
      </div>
      <ol class="pasos">
        <li>
          <span class="pasos__num">01</span>
          <h3>Elegí</h3>
          <p>Sumá al carrito los cuadernos que quieras, con el color y el grabado que prefieras.</p>
        </li>
        <li>
          <span class="pasos__num">02</span>
          <h3>Pagá</h3>
          <p>Con Mercado Pago (tarjeta, débito o dinero en cuenta) o por transferencia bancaria.</p>
        </li>
        <li>
          <span class="pasos__num">03</span>
          <h3>Recibí</h3>
          <p>
            {envio.texto}{' '}
            {envio.costo === null ? envio.textoSinCosto : `Costo fijo: ${formatoPrecio(envio.costo)}.`} O retiralo sin cargo en {retiro.texto.split('.')[0]}.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="seccion preguntas" id="preguntas">
    <div class="contenedor contenedor--angosto">
      <div class="encabezado">
        <span class="antetitulo">Preguntas frecuentes</span>
        <h2>Antes de comprar</h2>
      </div>
      {
        tienda.preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(48px, 7vw, 88px);
    text-align: center;
  }
  .hero__centro {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__logo {
    width: auto;
    height: clamp(260px, 42vw, 440px);
    margin: 8px 0 28px;
  }
  .hero__lema {
    font-size: clamp(1.25rem, 2.6vw, 1.6rem);
    color: var(--musgo);
    margin-bottom: 26px;
  }
  .hero .manchas {
    margin-bottom: 36px;
  }

  .banda__foto {
    width: 100%;
    height: clamp(280px, 48vw, 620px);
    object-fit: cover;
    object-position: center 60%;
  }

  .encabezado {
    text-align: center;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .productos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 36px);
  }
  @media (max-width: 760px) {
    .productos {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 14px;
      row-gap: 32px;
    }
  }
  .tarjeta {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  .tarjeta__foto {
    overflow: hidden;
    border-radius: 3px;
    background: var(--papel-2);
    margin-bottom: 14px;
  }
  .tarjeta__foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tarjeta:hover .tarjeta__foto :global(img) {
    transform: scale(1.04);
  }
  .tarjeta h3 {
    font-size: clamp(1.1rem, 2.4vw, 1.45rem);
    margin-bottom: 4px;
  }
  .tarjeta__precio {
    font-weight: 600;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
  }
  .desde {
    font-weight: 400;
    color: var(--tinta-suave);
  }
  .tarjeta:hover h3 {
    color: var(--terracota);
  }

  .oficio {
    background: var(--papel-2);
  }
  .oficio__grilla {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .oficio__grilla h2 {
    margin-bottom: 20px;
  }
  .oficio__grilla p {
    font-size: 1.05rem;
    max-width: 44ch;
  }
  .oficio__lema {
    color: var(--musgo);
    font-size: 1.3rem !important;
    margin-top: 28px;
  }
  .oficio__foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 3px;
  }
  @media (max-width: 820px) {
    .oficio__grilla {
      grid-template-columns: 1fr;
    }
    .oficio__foto {
      aspect-ratio: 1;
    }
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--arena);
  }
  .pasos li {
    padding: 32px 28px 8px 0;
  }
  .pasos li + li {
    padding-left: 28px;
    border-left: 1px solid var(--arena);
  }
  .pasos__num {
    display: block;
    font: 400 0.8rem/1 var(--mono);
    letter-spacing: 0.15em;
    color: var(--terracota);
    margin-bottom: 16px;
  }
  .pasos h3 {
    margin-bottom: 8px;
    color: var(--vino);
  }
  .pasos p {
    color: var(--tinta-suave);
    margin: 0;
  }
  @media (max-width: 820px) {
    .pasos {
      grid-template-columns: 1fr;
    }
    .pasos li,
    .pasos li + li {
      padding: 24px 0;
      border-left: 0;
      border-bottom: 1px solid var(--arena);
    }
  }

  .preguntas {
    padding-top: 0;
  }
  .contenedor--angosto {
    max-width: 780px;
  }
  details {
    border-bottom: 1px solid var(--arena);
  }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font: 400 1.2rem/1.3 var(--serif);
    color: var(--vino);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    font-family: var(--sans);
    color: var(--terracota);
    transition: transform 0.2s;
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    color: var(--tinta-suave);
    padding-bottom: 12px;
  }
</style>
